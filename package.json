{
  "name": "pulau-tirta",
  "version": "0.1.0",
  "private": true,
  "description": "Petualangan Pulau Tirta: game PWA siklus air untuk siswa SD kelas V, dengan avatar AI Tiko yang menuntun tanpa memberi jawaban.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "world:browser": "node scripts/check-world-browser.mjs",
    "world:export": "node scripts/export-world.mjs",
    "world:check": "node scripts/export-world.mjs --check",
    "predev": "npm run world:export",
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "prebuild": "npm run world:export",
    "build": "vite build",
    "start": "npm run build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "uji:tiko": "tsx scripts/uji-tiko.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.2.7"
  }
}
