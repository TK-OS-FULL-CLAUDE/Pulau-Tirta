# Salin menjadi .env lalu isi. File .env TIDAK di-commit.
# Penyedia model Tiko: gemini atau anthropic. Kosongkan untuk memilih otomatis dari key yang terisi.
TIKO_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Maksimal 7500 ms agar masih ada waktu untuk cadangan sebelum batas 8 detik.
TIKO_TIMEOUT_MS=7000
# Jarak antarpanggilan uji online; naikkan sesuai kuota penyedia. Tidak memperlambat chat di game.
TIKO_UJI_JEDA_MS=4500
# TIKO_MOCK=1 mematikan panggilan model selama pengembangan.
